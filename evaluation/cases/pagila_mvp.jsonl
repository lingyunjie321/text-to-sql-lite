{"case_id":"PG-MVP-006","status":"verified","category":"multi_join","question":"列出 Comedy 分类下的影片编号和标题。","datasource_id":"pagila","dialect":"postgres","allowed_tables":["film","film_category","category"],"expected_behavior":"EXECUTE","expected_final_status":"SUCCEEDED_FIRST_PASS","gold_tables":["film","film_category","category"],"gold_fields":["film.film_id","film.title","film_category.film_id","film_category.category_id","category.category_id","category.name"],"gold_join_edges":["film.film_id=film_category.film_id","film_category.category_id=category.category_id"],"gold_sql":"SELECT f.film_id, f.title FROM film AS f JOIN film_category AS fc ON fc.film_id = f.film_id JOIN category AS c ON c.category_id = fc.category_id WHERE c.name = 'Comedy'","gold_result_source":"execute_gold_sql","comparison_mode":"multiset","order_sensitive":false,"numeric_tolerances":{},"tags":["multi_join","category","mvp_gate"],"difficulty":"medium"}
{"case_id":"PG-MVP-007","status":"verified","category":"multi_join","question":"统计每位演员参演的影片数量。","datasource_id":"pagila","dialect":"postgres","allowed_tables":["actor","film_actor"],"expected_behavior":"EXECUTE","expected_final_status":"SUCCEEDED_FIRST_PASS","gold_tables":["actor","film_actor"],"gold_fields":["actor.actor_id","actor.first_name","actor.last_name","film_actor.actor_id","film_actor.film_id"],"gold_join_edges":["actor.actor_id=film_actor.actor_id"],"gold_sql":"SELECT a.actor_id, a.first_name, a.last_name, COUNT(fa.film_id) AS film_count FROM actor AS a LEFT JOIN film_actor AS fa ON fa.actor_id = a.actor_id GROUP BY a.actor_id, a.first_name, a.last_name","gold_result_source":"execute_gold_sql","comparison_mode":"multiset","order_sensitive":false,"numeric_tolerances":{},"tags":["multi_join","aggregation","actor","mvp_gate"],"difficulty":"medium"}
{"case_id":"PG-MVP-008","status":"draft","category":"multi_join","question":"列出客户编号、姓名以及所在国家。","datasource_id":"pagila","dialect":"postgres","allowed_tables":["customer","address","city","country"],"expected_behavior":"EXECUTE","expected_final_status":"SUCCEEDED_FIRST_PASS","gold_tables":["customer","address","city","country"],"gold_fields":["customer.customer_id","customer.first_name","customer.last_name","customer.address_id","address.address_id","address.city_id","city.city_id","city.country_id","country.country_id","country.country"],"gold_join_edges":["customer.address_id=address.address_id","address.city_id=city.city_id","city.country_id=country.country_id"],"gold_sql":"SELECT cu.customer_id, cu.first_name, cu.last_name, co.country FROM customer AS cu JOIN address AS a ON a.address_id = cu.address_id JOIN city AS ci ON ci.city_id = a.city_id JOIN country AS co ON co.country_id = ci.country_id","gold_result_source":"execute_gold_sql","comparison_mode":"multiset","order_sensitive":false,"numeric_tolerances":{},"tags":["multi_join","customer","join_path","mvp_gate"],"difficulty":"complex"}
{"case_id":"PG-MVP-009","status":"draft","category":"multi_join","question":"列出尚未归还的租赁编号、客户姓名和影片标题。","datasource_id":"pagila","dialect":"postgres","allowed_tables":["rental","customer","inventory","film"],"expected_behavior":"EXECUTE","expected_final_status":"SUCCEEDED_FIRST_PASS","gold_tables":["rental","customer","inventory","film"],"gold_fields":["rental.rental_id","rental.customer_id","rental.inventory_id","rental.return_date","customer.customer_id","customer.first_name","customer.last_name","inventory.inventory_id","inventory.film_id","film.film_id","film.title"],"gold_join_edges":["rental.customer_id=customer.customer_id","rental.inventory_id=inventory.inventory_id","inventory.film_id=film.film_id"],"gold_sql":"SELECT r.rental_id, c.first_name, c.last_name, f.title FROM rental AS r JOIN customer AS c ON c.customer_id = r.customer_id JOIN inventory AS i ON i.inventory_id = r.inventory_id JOIN film AS f ON f.film_id = i.film_id WHERE r.return_date IS NULL","gold_result_source":"execute_gold_sql","comparison_mode":"multiset","order_sensitive":false,"numeric_tolerances":{},"tags":["multi_join","rental","null_filter","mvp_gate"],"difficulty":"complex"}
