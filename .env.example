PAGILA_POSTGRES_PASSWORD=
PAGILA_APP_USER=text_to_sql_reader
PAGILA_APP_PASSWORD=
PAGILA_HOST_PORT=55432

# ── Default / Primary Datasource ────────────────────────────
# type: postgresql | mysql | starrocks
TEXT_TO_SQL_DATABASE_TYPE=postgresql
TEXT_TO_SQL_DATABASE_DATASOURCE_ID=pagila
# For PostgreSQL: use DSN
TEXT_TO_SQL_DATABASE_DSN=
# For MySQL / StarRocks: use host-based config (ignored when DSN is set)
# TEXT_TO_SQL_DATABASE_HOST=127.0.0.1
# TEXT_TO_SQL_DATABASE_PORT=3306
# TEXT_TO_SQL_DATABASE_DATABASE=mydb
# TEXT_TO_SQL_DATABASE_USERNAME=reader
# TEXT_TO_SQL_DATABASE_PASSWORD=

TEXT_TO_SQL_DATABASE_MIN_POOL_SIZE=1
TEXT_TO_SQL_DATABASE_MAX_POOL_SIZE=4
TEXT_TO_SQL_DATABASE_POOL_TIMEOUT_SECONDS=5
TEXT_TO_SQL_DATABASE_STATEMENT_TIMEOUT_SECONDS=30
TEXT_TO_SQL_DATABASE_MAX_RESULT_ROWS=1000
TEXT_TO_SQL_DATABASE_CONNECTION_RETRY_COUNT=1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0
LLM_MAX_INPUT_TOKENS=32768
LLM_MAX_OUTPUT_TOKENS=2048

# Optional server-owned route overrides. Leave an entire route unset to
# inherit the base LLM_* values. These placeholders are commented so a copied
# .env does not turn an empty optional value into an invalid override.
# LLM_SIMPLE_BASE_URL=
# LLM_SIMPLE_API_KEY=
# LLM_SIMPLE_MODEL=
# LLM_SIMPLE_TIMEOUT_SECONDS=30
# LLM_SIMPLE_TEMPERATURE=0
# LLM_SIMPLE_MAX_INPUT_TOKENS=32768
# LLM_SIMPLE_MAX_OUTPUT_TOKENS=2048
# LLM_STANDARD_BASE_URL=
# LLM_STANDARD_API_KEY=
# LLM_STANDARD_MODEL=
# LLM_STANDARD_TIMEOUT_SECONDS=30
# LLM_STANDARD_TEMPERATURE=0
# LLM_STANDARD_MAX_INPUT_TOKENS=32768
# LLM_STANDARD_MAX_OUTPUT_TOKENS=2048
# LLM_COMPLEX_BASE_URL=
# LLM_COMPLEX_API_KEY=
# LLM_COMPLEX_MODEL=
# LLM_COMPLEX_TIMEOUT_SECONDS=30
# LLM_COMPLEX_TEMPERATURE=0
# LLM_COMPLEX_MAX_INPUT_TOKENS=32768
# LLM_COMPLEX_MAX_OUTPUT_TOKENS=2048
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=
# LLM_FALLBACK_TIMEOUT_SECONDS=30
# LLM_FALLBACK_TEMPERATURE=0
# LLM_FALLBACK_MAX_INPUT_TOKENS=32768
# LLM_FALLBACK_MAX_OUTPUT_TOKENS=2048

MODEL_ROUTING_DATA_BOUNDARY_ID=production-primary-boundary-v1
MODEL_ROUTING_SIMPLE_FALLBACK_ENABLED=false
MODEL_ROUTING_STANDARD_FALLBACK_ENABLED=false
MODEL_ROUTING_COMPLEX_FALLBACK_ENABLED=false

# ── Security & Request Override Policy ───────────────────────
# API key for bearer auth (optional; unset = no auth, fixed identity)
# TEXT_TO_SQL_API_KEY=
# Debug key granting debug=true access (optional)
# TEXT_TO_SQL_DEBUG_KEY=
# Allow request-body inline datasource connections (DANGEROUS; default false)
TEXT_TO_SQL_ALLOW_ADHOC_DATASOURCES=false

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_MAX_BATCH_DOCUMENTS=10
EMBEDDING_MAX_RESPONSE_BYTES=4194304
